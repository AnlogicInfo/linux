/dts-v1/;
#include "anlogic-dr1m90.dts"

&cma {
	alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
	size = <0x0 0x10000000>;
};

&memory {
	reg = <0 0x00000000 0 0x40000000>;
};

&soc {
	soft_npu: soft_npu@1F0000000 {
		compatible = "anlogic,soft_npu";
		reg = <0x1 0xF0000000 0x0 0x00100000>;
		interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;
	};

	serialpl0: serial@A0000000 {
		compatible = "anlogic,xps-uartlite-1.00.a";
		reg = <0x0 0xA0000000 0x0 0x1000>;
		clock-frequency = <50000000>;
		interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
		port-number = <0>;
		anlogic,baudrate = <115200>;
		current-speed = <115200>;
		anlogic,use-parity = <0x0>;
		anlogic,odd-parity = <0x0>;
		anlogic,data-bits = <0x8>;
		status = "disabled";
	};

	leds {
		compatible = "gpio-leds";
		led1: led1 {
			gpios = <&porta 14 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			status = "okay";
		};
		led2: led2 {
			gpios = <&porta 13 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			status = "disabled";
		};
		led3: led3 {
			gpios = <&porta 12 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			status = "disabled";
		};
	};

	keys {
		compatible = "gpio-keys";
		sw6: sw6 {
			gpios = <&porta 10 GPIO_ACTIVE_LOW>;
			linux,code = <103>;
			status = "okay";
		};
		sw8: sw8 {
			gpios = <&porta 11 GPIO_ACTIVE_HIGH>;
			linux,code = <108>;
			status = "okay";
		};
		sw5: sw5 {
			gpios = <&portc 0 GPIO_ACTIVE_HIGH>;
			linux,code = <108>;
			status = "okay";
		};
	};
};

&serial0 {
	status = "disabled";
};

&serial1 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	i2c-mux@74 {
		compatible = "nxp,pca9548";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x74>;
		status = "okay";

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
			/*
			 * IIC_EEPROM 1kB memory which uses 256B blocks
			 * where every block has different address.
			 *    0 - 256B address 0x54
			 * 256B - 512B address 0x55
			 * 512B - 768B address 0x56
			 * 768B - 1024B address 0x57
			 */
			m24c08: eeprom@54 {
				compatible = "atmel,24c08";
				reg = <0x54>;
				pagesize = <16>;
				address-width = <8>;
				status = "okay";
			};
		};

		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			ds1337: rtc@68 {
				compatible = "dallas,ds1337";
				reg = <0x68>;
				trickle-resistor-ohms = <250>;
				status = "okay";
			};
		};

	};
};

&i2c1 {
	status = "disabled";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&axidmac {
	status = "okay";
};

&watchdog0 {
	status = "disabled";
};

&ipmscan0 {
	status = "okay";
};

&ipmscan1 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
};

&sdhci1 {
	status = "disabled";
};

&ahb_dma {
	status = "okay";
};

&qspi0 {
	status = "okay";

	//spidev@0 {
	//	compatible = "rohm,dh2228fv";
	//	reg = <0>;
	//	spi-max-frequency = <8000000>;
	//};

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		label = "alspinor";
		reg = <0x0>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <AL_QSPI_MAX_FREQUENCY>;
	};

	//num-cs = <2>;
	//cs-gpios = <&gpio0 13 0>,
	//<&gpio0 14 0>;v
};

&spi0 {
	status = "okay";
};

&spi1 {
	status = "okay";
};

&ttc0 {
	status = "okay";
};

&ttc1 {
	status = "okay";
};

&eqos0 {
	status = "okay";
};

&eth_phy0 {
	/* Realtek RTL8211F (0x001cc916) */
	status = "okay";
};

&eth_phy1 {
	/* Motorcomm YT8531 (0x4f51e91b) */
	status = "disabled";
};

&eqos1 {
	status = "disabled";
};

&eth_phy2 {
	/* Realtek RTL8211F (0x001cc916) */
	status = "disabled";
};

&eth_phy3 {
	/* Motorcomm YT8531 (0x4f51e91b) */
	status = "disabled";
};

&usb_otg0 {
	status = "okay";
};

&adc {
	status = "disabled";
};
