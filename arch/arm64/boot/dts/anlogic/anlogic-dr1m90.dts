/dts-v1/;
#include "anlogic-dr1m90.dtsi"
#include "anlogic-dr1m90-plat.h"

/ {
	aliases {
		uart0 = &serial1;
		eqos0 = &eqos0;
		ethernet0 = &eqos0;
		ethernet1 = &eqos1;
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
	};

	chosen: chosen {
		bootargs = "console=ttyS0,115200n8 earlycon=uart,mmio32,0xf8401000 loglevel=8";
		stdout-path = &serial1;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		cma: linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x0 0x400000>;
			linux,cma-default;
		};
	};

	memory: memory {
		device_type = "memory";
	};
};

&soc {
	jpu: jpu@f8460000 {
		compatible = "anlogic,jpu";
		reg = <0x0 0xF8460000 0x0 0x00010000>;
		interrupts = <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>;
	};

	cryst_osc: cryst_osc {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <AL_CRYST_OSC_CLOCK>;
		clock-output-names = "cryst_osc";
	};

	ttc_ext_clk: ttc_ext_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <AL_TC_CLOCK>;
		clock-output-names = "ttc_ext_clk";
	};

	PHY_CLK: PHY_CLK {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <AL_ETH_PHY_CLOCK>;
		clock-output-names = "PHY_CLK";
	};
};

&cpu0 {
	clock-frequency = <AL_PROCESSOR_CORE0_CLOCK>;
};

&cpu1 {
	clock-frequency = <AL_PROCESSOR_CORE1_CLOCK>;
};

&timer {
	clock-frequency = <AL_PROCESSOR_CORE0_COUNTER_CLOCK>;
};

&serial0 {
	clocks = <&crp CLK_UART>, <&crp CLK_APB>;
	clock-names = "baudclk", "apb_pclk";
};

&serial1 {
	clocks = <&crp CLK_UART>, <&crp CLK_APB>;
	clock-names = "baudclk", "apb_pclk";
};

&i2c0 {
	clocks = <&crp CLK_I2C>;
	clock-names = "IIC_CLK";
	clock-frequency = <AL_I2C0PS_RATE>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;
};

&i2c1 {
	clocks = <&crp CLK_I2C>;
	clock-names = "IIC_CLK";
	clock-frequency = <AL_I2C1PS_RATE>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;
};

&gpio0 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&gpio1 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&gpio2 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&gpio3 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&axidmac {
	clock-names = "apb_pclk";
	clocks = <&crp CLK_APB>;
};

&watchdog0 {
	clocks = <&crp CLK_WDT>;
};

&ipmscan0 {
	clocks = <&crp CLK_CAN0>;
	clock-names = "ipms_can_clk";
};

&ipmscan1 {
	clocks = <&crp CLK_CAN1>;
	clock-names = "ipms_can_clk";
};

&sdhci0 {
	clocks = <&crp CLK_MMC_CORE>, <&crp CLK_MMC_BUS>;
	clock-names = "core", "bus";
	max-frequency = <AL_MMC0_PS_MAX_FREQ>;
	sdhci-caps-mask = <0x00FF0000 0x0600FF00>;
	sdhci-caps = <0x10000 0x3200>;
	bus-width = <AL_MMC0_PS_BUS_WIDTH>;
	#if AL_MMC0_PS_CD_ENABLE
	cd-gpios=<&AL_MMC0_PS_CD_GPIO_BANK AL_MMC0_PS_CD_GPIO_PORT GPIO_ACTIVE_LOW>;
	#else
	non-removable;
	broken-cd;
	#endif
	disable-wp;
	no-sdio;
	no-1-8-v;
	sdhci,auto-cmd12;
};

&sdhci1 {
	clocks = <&crp CLK_MMC_CORE>, <&crp CLK_MMC_BUS>;
	clock-names = "core", "bus";
	max-frequency = <AL_MMC1_PS_MAX_FREQ>;
	sdhci-caps-mask = <0x00FF0000 0x0600FF00>;
	sdhci-caps = <0x10000 0x3200>;
	bus-width = <AL_MMC1_PS_BUS_WIDTH>;
	#if AL_MMC1_PS_CD_ENABLE
	cd-gpios=<&AL_MMC1_PS_CD_GPIO_BANK AL_MMC1_PS_CD_GPIO_PORT GPIO_ACTIVE_LOW>;
	#else
	non-removable;
	broken-cd;
	#endif
	disable-wp;
	no-sdio;
	no-1-8-v;
	sdhci,auto-cmd12;
};

&ahb_dma {
	clocks = <&crp CLK_DMAC_AHB>;
};

&qspi0 {
	clocks = <&crp CLK_QSPI>;
	dmas = <&ahb_dma 0xc 0 0 (1 << 6)>,
			<&ahb_dma 0xd 0 0 (1 << 7)>;
	dma-names = "tx", "rx";
};

&spi0 {
	clocks = <&crp CLK_SPI>;
	dmas = <&ahb_dma 4 0 0 (1 << 0)>,
			<&ahb_dma 5 0 0 (1 << 1)>;
	dma-names = "tx", "rx";
	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <AL_SPI0_MAX_FREQUENCY>;
	};
};

&spi1 {
	clocks = <&crp CLK_SPI>;
	dmas = <&ahb_dma 6 0 0 (1 << 2)>,
			<&ahb_dma 7 0 0 (1 << 3)>;
	dma-names = "tx", "rx";
	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <AL_SPI1_MAX_FREQUENCY>;
	};
};

&ttc0 {
	clocks = <&crp CLK_APB>, <&ttc_ext_clk>;
};

&ttc1 {
	clocks = <&crp CLK_APB>, <&ttc_ext_clk>;
};

&eqos0 {
	clocks = <&crp CLK_GBE>,<&PHY_CLK>,<&crp CLK_PTP>;
	clock-names = "apb_pclk","phy_ref_clk","ptp_ref";
	phy-mode = AL_ETH0_PHY_MODE;
};

&eqos1 {
	clocks = <&crp CLK_GBE>,<&PHY_CLK>,<&crp CLK_PTP>;
	clock-names = "apb_pclk","phy_ref_clk","ptp_ref";
	phy-mode = AL_ETH1_PHY_MODE;
};

&usb_otg0 {
	dr_mode = "host";
	g-np-tx-fifo-size = <32>;
	g-rx-fifo-size = <768>;
	g-tx-fifo-size = <768 512 512 32 16 16 16 16 16 16>;
	g-use-dma;
};

&adc {
	clocks = <&crp CLK_APB>, <&crp CLK_ADCPL>;
};

&smcc {
	clock-names = "memclk", "apb_pclk";
	clocks = <&crp CLK_SMC>, <&crp CLK_APB>;

	nfc0: nand-controller@0 {
		compatible = "arm,pl353-nand-r2p1";
		reg = <0x0 0x0 0x0 0x1000000>;
		#address-cells = <1>;
		#size-cells = <0>;

		nand@0 {
			// nand-ecc-mode = "hw";
			// nand-bus-width = <8>;
			label = "alnand0";
			reg = <0x0>;

		};
	};
};
