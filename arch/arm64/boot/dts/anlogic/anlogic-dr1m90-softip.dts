&soc {
	axi_uart0: serial@80020000 {
		compatible = "anlogic,xps-uartlite-1.00.a";
		reg = <0x0 0x80020000 0x0 0x1000>;
		interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>; /* BM 116 */
		clock-frequency = <50000000>;
		port-number = <0>;
		anlogic,baudrate = <115200>;
		current-speed = <115200>;
		anlogic,use-parity = <0x0>;
		anlogic,odd-parity = <0x0>;
		anlogic,data-bits = <0x8>;
		status = "disabled";
	};

	axi_uart1: serial@1f1020000 {
		compatible = "anlogic,xps-uartlite-1.00.a";
		reg = <0x1 0xf1020000 0x0 0x1000>;
		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>; /* BM 124 */
		clock-frequency = <50000000>;
		port-number = <1>;
		anlogic,baudrate = <115200>;
		current-speed = <115200>;
		anlogic,use-parity = <0x0>;
		anlogic,odd-parity = <0x0>;
		anlogic,data-bits = <0x8>;
		status = "disabled";
	};

	axi_gpio0: gpio@0x80010000 {
		compatible = "anlogic,axi-gpio-1.00.a";
		reg = <0x0 0x80010000 0x0 0x10000>;
		interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;/* BM 115 */
		#gpio-cells = <2>;
		#interrupt-cells = <0x2>;
		gpio-controller;
		anlogic,all-inputs = <0x0>;
		anlogic,all-inputs-2 = <0x0>;
		anlogic,all-outputs = <0x0>;
		anlogic,all-outputs-2 = <0x0>;
		anlogic,dout-default = <0x0>;
		anlogic,dout-default-2 = <0x0>;
		anlogic,gpio-width = <0x20>;
		anlogic,gpio2-width = <0x20>;
		anlogic,interrupt-present = <0x1>;
		anlogic,is-dual = <0x1>;
		anlogic,tri-default = <0xFFFFFFFF>;
		anlogic,tri-default-2 = <0xFFFFFFFF>;
		status = "disabled";
	};

	axi_gpio1: gpio@1f1000000 {
		compatible = "anlogic,axi-gpio-1.00.a";
		reg = <0x1 0xf1000000 0x0 0x10000>;
		interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;/* BM 123 */
		#gpio-cells = <2>;
		#interrupt-cells = <0x2>;
		gpio-controller;
		anlogic,all-inputs = <0x0>;
		anlogic,all-inputs-2 = <0x0>;
		anlogic,all-outputs = <0x0>;
		anlogic,all-outputs-2 = <0x0>;
		anlogic,dout-default = <0x0>;
		anlogic,dout-default-2 = <0x0>;
		anlogic,gpio-width = <0x20>;
		anlogic,gpio2-width = <0x20>;
		anlogic,interrupt-present = <0x1>;
		anlogic,is-dual = <0x1>;
		anlogic,tri-default = <0xFFFFFFFF>;
		anlogic,tri-default-2 = <0xFFFFFFFF>;
		status = "disabled";
	};

	axi_gpio-keys {
		compatible = "gpio-keys";
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		axi_key3: axi_key3 {
			/* gpio0_ch1_io[0] */
			gpios = <&axi_gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <105>;/* KEY_LEFT */
			status = "okay";
		};

		axi_key4: axi_key4 {
			/* gpio1_ch1_gpio_io_i[0] */
			gpios = <&axi_gpio1 0 GPIO_ACTIVE_LOW>;

			linux,code = <106>;/* KEY_RIGHT */
			status = "okay";
		};
	};

	axi_i2c0: axi_i2c@80030000 {
		compatible = "anlogic-axi-i2c-controller";
		interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <50000000>;
		reg = <0 0x80030000 0 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	axi_i2c1: axi_i2c@1f1030000 {
		compatible = "anlogic-axi-i2c-controller";
		interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <50000000>;
		reg = <0x1 0xf1030000 0 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	axi_dma: axidma@80000000 {
		#dma-cells = <1>;
		compatible = "anlogic,axi-dma";
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
		reg = <0x0 0x80000000 0x0 0x1000>;
		anlogic,addrwidth = <0x20>;
		anlogic,include-sg;
		status = "disabled";

		dma-channel@80000000 {
			compatible = "anlogic,axi-dma-mm2s-channel";
			dma-channels = <0x1>;
			interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
			anlogic,datawidth = <0x20>;
			anlogic,include-dre;
		};

		dma-channel@80000030 {
			compatible = "anlogic,axi-dma-s2mm-channel";
			dma-channels = <0x1>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
			anlogic,datawidth = <0x20>;
			anlogic,include-dre;
		};
	};
};
