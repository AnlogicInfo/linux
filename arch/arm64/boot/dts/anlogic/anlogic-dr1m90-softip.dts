&soc {
	AXI_I2C_CLK: AXI_I2C_CLK {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <50000000>;
		clock-output-names = "AXI_I2C_CLK";
	};

	axi_uart0: serial@80020000 {
		compatible = "anlogic,xps-uartlite-1.00.a";
		/* reg = <0x0 0xA0000000 0x0 0x1000>; */
		/* interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>; */ /* BM 114 */
		reg = <0x0 0x80020000 0x0 0x1000>;
		interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>; /* BM 116 */
		clock-frequency = <50000000>;
		port-number = <0>;
		anlogic,baudrate = <115200>;
		current-speed = <115200>;
		anlogic,use-parity = <0x0>;
		anlogic,odd-parity = <0x0>;
		anlogic,data-bits = <0x8>;
		status = "disabled";
	};

	axi_uart1: serial@A0020000 {
		compatible = "anlogic,xps-uartlite-1.00.a";
		reg = <0x0 0xA0020000 0x0 0x1000>;
		interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>; /* BM 124 */
		clock-frequency = <50000000>;
		port-number = <1>;
		anlogic,baudrate = <115200>;
		current-speed = <115200>;
		anlogic,use-parity = <0x0>;
		anlogic,odd-parity = <0x0>;
		anlogic,data-bits = <0x8>;
		status = "disabled";
	};

	axi_gpio0: gpio@0x80010000 {
		compatible = "anlogic,axi-gpio-1.00.a";
		/*reg = <0x0 0x80000000 0x0 0x10000>;*/
		/*interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;*/ /* BM 114 */
		reg = <0x0 0x80010000 0x0 0x10000>;
		interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;/* BM 115 */
		#gpio-cells = <2>;
		#interrupt-cells = <0x2>;
		gpio-controller;
		anlogic,all-inputs = <0x0>;
		anlogic,all-inputs-2 = <0x0>;
		anlogic,all-outputs = <0x0>;
		anlogic,all-outputs-2 = <0x0>;
		anlogic,dout-default = <0x0>;
		anlogic,dout-default-2 = <0x0>;
		anlogic,gpio-width = <0x20>;
		anlogic,gpio2-width = <0x20>;
		anlogic,interrupt-present = <0x1>;
		anlogic,is-dual = <0x1>;
		anlogic,tri-default = <0xFFFFFFFF>;
		anlogic,tri-default-2 = <0xFFFFFFFF>;
		status = "disabled";
	};

	axi_gpio1: gpio@A0000000 {
		compatible = "anlogic,axi-gpio-1.00.a";
		reg = <0x0 0xA0000000 0x0 0x10000>;
		interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;/* BM 123 */
		#gpio-cells = <2>;
		#interrupt-cells = <0x2>;
		gpio-controller;
		anlogic,all-inputs = <0x0>;
		anlogic,all-inputs-2 = <0x0>;
		anlogic,all-outputs = <0x0>;
		anlogic,all-outputs-2 = <0x0>;
		anlogic,dout-default = <0x0>;
		anlogic,dout-default-2 = <0x0>;
		anlogic,gpio-width = <0x20>;
		anlogic,gpio2-width = <0x20>;
		anlogic,interrupt-present = <0x1>;
		anlogic,is-dual = <0x1>;
		anlogic,tri-default = <0xFFFFFFFF>;
		anlogic,tri-default-2 = <0xFFFFFFFF>;
		status = "disabled";
	};

	axi_gpio-keys {
		compatible = "gpio-keys";
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		axi_key1: axi_key1 {
			/* gpio0_ch1_io[0] */
			gpios = <&axi_gpio0 0 GPIO_ACTIVE_LOW>;
			linux,code = <103>;/* KEY_UP */
			status = "disabled";
		};

		axi_key2: axi_key2 {
			/* gpio0_ch2_io[0] */
			gpios = <&axi_gpio0 32 GPIO_ACTIVE_LOW>;
			linux,code = <108>;/* KEY_DOWN */
			status = "disabled";
		};

		axi_key3: axi_key3 {
			/* gpio1_ch1_io[0] */
			gpios = <&axi_gpio1 0 GPIO_ACTIVE_LOW>;
			linux,code = <105>;/* KEY_LEFT */
			status = "disabled";
		};

		axi_key4: axi_key4 {
			/* gpio1_ch1_io[1] */
			gpios = <&axi_gpio1 1 GPIO_ACTIVE_LOW>;
			linux,code = <106>;/* KEY_RIGHT */
			status = "disabled";
		};
	};

	axi_i2c: axi_i2c@80030000 {
		compatible = "anlogic-axi-i2c-controller";
		interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
		reg = <0 0x80030000 0 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		clocks = <&AXI_I2C_CLK>;
		clock-names = "AXI_I2C_CLK";
		status = "disabled";

		/*
		 * for dr1m90-ad101-v10,
		 * if using axi i2c, it is necessary to block i2c0 on the PS side.
		 */
		i2c-mux@74 {
			compatible = "nxp,pca9548";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x74>;
			status = "okay";

			i2c@2 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <2>;
				/*
				 * IIC_EEPROM 1kB memory which uses 256B blocks
				 * where every block has different address.
				 *    0 - 256B address 0x54
				 * 256B - 512B address 0x55
				 * 512B - 768B address 0x56
				 * 768B - 1024B address 0x57
				 */
				axi_m24c08: eeprom@54 {
					compatible = "atmel,24c08";
					reg = <0x54>;
					pagesize = <16>;
					address-width = <8>;
					status = "okay";
				};
			};

			i2c@3 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <3>;
				axi_ds1337: rtc@68 {
					compatible = "dallas,ds1337";
					reg = <0x68>;
					trickle-resistor-ohms = <250>;
					status = "okay";
				};
			};
		};
	};
};
