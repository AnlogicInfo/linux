/dts-v1/;
#include "anlogic-dr1v90.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	chosen {
		bootargs = "earlycon=sbi console=ttyS0,115200";
	};

	aliases: aliases {
		ethernet0 = &eqos0;
		mmc0 = &sdhci0;
		mmc1 = &sdhci1;
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		dma: linux,dma {
			compatible = "shared-dma-pool";
			reg = <0x0 0x10000000 0x0 0x01000000>;
			no-map;
			linux,dma-default;
		};

		cma: linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x0 0x400000>;
			linux,cma-default;
		};
	};

	memory: memory@0 {
		device_type = "memory";
	};
};

&cpus {
	timebase-frequency =<AL_PROCESSOR_CORE0_CLOCK>;
};

&cpu0 {
	clock-frequency = <AL_PROCESSOR_CORE0_CLOCK>;
	status = "okay";
};

&soc {
	cryst_osc: cryst_osc {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <AL_CRYST_OSC_CLOCK>;
		clock-output-names = "cryst_osc";
	};

	ttc_ext_clk: ttc_ext_clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <AL_TC_CLOCK>;
		clock-output-names = "ttc_ext_clk";
	};

	PHY_CLK: PHY_CLK {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <AL_ETH_PHY_CLOCK>;
		clock-output-names = "PHY_CLK";
	};
};

&uart0 {
	clocks = <&crp CLK_UART>, <&crp CLK_APB>;
	clock-names = "baudclk", "apb_pclk";
};

&uart1 {
	clocks = <&crp CLK_UART>, <&crp CLK_APB>;
	clock-names = "baudclk", "apb_pclk";
};

&ipmscan0 {
	clocks = <&crp CLK_CAN0>;
	clock-names = "ipms_can_clk";
};

&ipmscan1 {
	clocks = <&crp CLK_CAN1>;
	clock-names = "ipms_can_clk";
};

&i2c0 {
	clocks = <&crp CLK_I2C>;
	clock-names = "IIC_CLK";
	clock-frequency = <AL_I2C0PS_RATE>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;
};

&i2c1 {
	clocks = <&crp CLK_I2C>;
	clock-names = "IIC_CLK";
	clock-frequency = <AL_I2C1PS_RATE>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <300>;
	i2c-scl-falling-time-ns = <300>;
};

&gpio0 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&gpio1 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&gpio2 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&gpio3 {
	clocks = <&crp CLK_GPIO>, <&crp CLK_GPIO_DB>;
	clock-names = "bus", "db";
};

&watchdog0 {
	clocks = <&crp CLK_WDT>;
};

&qspi0 {
	clocks = <&crp CLK_QSPI>;
};

&spi0 {
	clocks = <&crp CLK_SPI>;
};

&spi1 {
	clocks = <&crp CLK_SPI>;
};

&ttc0 {
	clocks = <&crp CLK_APB>, <&ttc_ext_clk>;
};

&ttc1 {
	clocks = <&crp CLK_APB>, <&ttc_ext_clk>;
};

&sdhci0 {
	dma-noncoherent;
	clocks = <&crp CLK_MMC_CORE>, <&crp CLK_MMC_BUS>;
	clock-names = "core", "bus";
	sdhci-caps-mask = <0x00FF0000 0x0600FF00>;
	sdhci-caps = <0x10000 0x3200>;
	max-frequency = <AL_MMC0_PS_MAX_FREQ>;
	bus-width = <AL_MMC0_PS_BUS_WIDTH>;
	#if AL_MMC0_PS_CD_ENABLE
	cd-gpios=<&AL_MMC0_PS_CD_GPIO_BANK AL_MMC0_PS_CD_GPIO_PORT GPIO_ACTIVE_LOW>;
	#else
	non-removable;
	broken-cd;
	#endif
	disable-wp;
	no-sdio;
	no-1-8-v;
	sdhci,auto-cmd12;
};

&sdhci1 {
	dma-noncoherent;
	clocks = <&crp CLK_MMC_CORE>, <&crp CLK_MMC_BUS>;
	clock-names = "core", "bus";
	sdhci-caps-mask = <0x00FF0000 0x0600FF00>;
	sdhci-caps = <0x10000 0x3200>;
	max-frequency = <AL_MMC1_PS_MAX_FREQ>;
	bus-width = <AL_MMC1_PS_BUS_WIDTH>;
	#if AL_MMC1_PS_CD_ENABLE
	cd-gpios=<&AL_MMC1_PS_CD_GPIO_BANK AL_MMC1_PS_CD_GPIO_PORT GPIO_ACTIVE_LOW>;
	#else
	non-removable;
	broken-cd;
	#endif
	disable-wp;
	no-sdio;
	no-1-8-v;
	sdhci,auto-cmd12;
};

&eqos0 {
	clocks = <&crp CLK_GBE>,<&PHY_CLK>,<&crp CLK_PTP>;
	clock-names = "apb_pclk","phy_ref_clk","ptp_ref";
};

&eqos1 {
	clocks = <&crp CLK_GBE>,<&PHY_CLK>,<&crp CLK_PTP>;
	clock-names = "apb_pclk","phy_ref_clk","ptp_ref";
};

&usb_otg0 {
	dr_mode = "host";
	g-np-tx-fifo-size = <32>;
	g-rx-fifo-size = <768>;
	g-tx-fifo-size = <768 512 512 32 16 16 16 16 16 16>;
	g-use-dma;
};

&dmac {
	clock-names = "apb_pclk";
	clocks = <&crp CLK_APB>;
};

&adc {
	clocks = <&crp CLK_APB>, <&crp CLK_ADCPL>;
};

&smcc {
	clock-names = "memclk", "apb_pclk";
	clocks = <&crp CLK_SMC>, <&crp CLK_APB>;
};
