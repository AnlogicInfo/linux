/dts-v1/;
#include "anlogic-dr1v90.dts"

&aliases {
	serial0 = &uart0;
	ethernet1 = &eqos1;
};

&cma {
	alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
	size = <0x0 0x10000000>;
};

&memory {
	reg = <0x0 0x00000000 0x0 0xfffffff>;
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "disabled";
};
