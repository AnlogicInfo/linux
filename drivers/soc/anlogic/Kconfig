menu "Anlogic SoC drivers"

config ANLOGIC_SOC
	bool "Anlogic SoC"
	select ARM_AMBA
	select SOC_BUS
	default n
	help
	  Say yes if need codes for Anlogic SoCs.

config ANLOGIC_TOP_CFG
	bool "Anlogic SoC Top Control"
	default y
	depends on ANLOGIC_SOC
	help
	  Say yes to enable Anlogic SoC Top control.

config ANLOGIC_TOP_USER_SACCESS
	bool "Anlogic SoC User Secure Access"
	default y
	depends on ANLOGIC_SOC && ANLOGIC_TOP_CFG && ARM64
	help
	  Say yes to enable accessing Anlogic SoC Top secure registers
	  from user space.

endmenu
